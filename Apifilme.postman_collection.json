{
  "info": {
    "name": "Apifilme - AP2 CRUD Completo",
    "description": "Collection de testes para a API de Filmes (AP2) com persistência em SQLite via EF Core.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5205",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 - Listar Filmes",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/filmes",
          "host": ["{{baseUrl}}"],
          "path": ["api", "filmes"]
        }
      },
      "response": []
    },
    {
      "name": "02 - Cadastrar Filme",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"titulo\": \"Interestelar\",\n  \"genero\": \"Ficção Científica\",\n  \"ano\": 2014,\n  \"nota\": 8.6\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/filmes",
          "host": ["{{baseUrl}}"],
          "path": ["api", "filmes"]
        }
      },
      "response": []
    },
    {
      "name": "03 - Buscar Filme por ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/filmes/1",
          "host": ["{{baseUrl}}"],
          "path": ["api", "filmes", "1"]
        }
      },
      "response": []
    },
    {
      "name": "04 - Atualizar Filme",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"titulo\": \"Interestelar (Edição Especial)\",\n  \"genero\": \"Ficção Científica\",\n  \"ano\": 2014,\n  \"nota\": 9.0\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/filmes/1",
          "host": ["{{baseUrl}}"],
          "path": ["api", "filmes", "1"]
        }
      },
      "response": []
    },
    {
      "name": "05 - Excluir Filme",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/filmes/1",
          "host": ["{{baseUrl}}"],
          "path": ["api", "filmes", "1"]
        }
      },
      "response": []
    },
    {
      "name": "06 - Buscar Filme Inexistente (404)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/filmes/999",
          "host": ["{{baseUrl}}"],
          "path": ["api", "filmes", "999"]
        }
      },
      "response": []
    }
  ]
}
